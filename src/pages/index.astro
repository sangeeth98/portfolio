---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Contact from '../components/Contact.astro';
---

<Layout title="Sangeeth | Software Engineer">
	<!-- Navbar Header -->
	<header class="navbar">
		<a href="#home" class="logo">
			<span class="logo-bracket">&lt;</span>sangeeth<span class="logo-bracket"> /&gt;</span>
		</a>
		<nav class="nav-menu">
			<div class="nav-links">
				<a href="#home">home</a>
				<a href="#about">about</a>
				<a href="#experience">experience</a>
				<a href="#projects">projects</a>
				
				<span class="nav-divider" aria-hidden="true"></span>
				
				<!-- Social Links -->
				<a href="https://www.linkedin.com/in/sangeethkumarvm/" target="_blank" rel="noopener noreferrer" class="nav-icon-link" aria-label="LinkedIn">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M22.23 0H1.77C.8 0 0 .77 0 1.72v20.56C0 23.23.8 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.72V1.72C24 .77 23.2 0 22.23 0zM7.12 20.45H3.56V9H7.12v11.45zM5.34 7.43c-1.14 0-2.06-.92-2.06-2.06 0-1.14.92-2.06 2.06-2.06 1.14 0 2.06.92 2.06 2.06 0 1.14-.92 2.06-2.06 2.06zm15.11 13.02h-3.56v-5.6c0-1.34-.03-3.05-1.86-3.05-1.86 0-2.14 1.45-2.14 2.95v5.7H9.33V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29z"/></svg>
				</a>
				<a href="https://github.com/sangeeth98" target="_blank" rel="noopener noreferrer" class="nav-icon-link" aria-label="GitHub">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
				</a>
				<a href="https://x.com/sangeethkumarvm" target="_blank" rel="noopener noreferrer" class="nav-icon-link" aria-label="Twitter">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
				</a>
				
				<span class="nav-divider" aria-hidden="true"></span>
				
				<button id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle theme">
					<svg id="theme-svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
						<path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"/>
					</svg>
					<span id="theme-text">neon</span>
				</button>
			</div>
		</nav>
	</header>

	<!-- Main Content -->
	<main>
		<Hero />
		<About />
		<Experience />
		<Projects />
		<Contact />
	</main>
</Layout>

<script>
	// Theme toggle: neon (dark) ↔ dim (lighter dark)
	const themeToggle = document.getElementById('theme-toggle');
	const themeText = document.getElementById('theme-text');

	function updateToggleButtonState() {
		const isDim = document.documentElement.classList.contains('dim-mode');
		if (themeText) {
			themeText.textContent = isDim ? 'dim' : 'neon';
		}
	}

	// Initial sync
	updateToggleButtonState();

	themeToggle?.addEventListener('click', () => {
		const root = document.documentElement;
		root.classList.toggle('dim-mode');
		
		const currentTheme = root.classList.contains('dim-mode') ? 'dim' : 'neon';
		localStorage.setItem('theme', currentTheme);
		updateToggleButtonState();
	});
</script>
