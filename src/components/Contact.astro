---
// Contact.astro: Footer with social links — no Discord, no full name, no hosting details
---

<section id="contact" class="contact-section">
  <div class="container">
    <div class="footer-divider"></div>

    <footer class="sitemap-footer">
      <!-- Brand -->
      <div class="footer-brand">
        <h4>
          <span class="logo-bracket">&lt;</span>sangeeth<span class="logo-bracket"> /&gt;</span>
        </h4>
        <p>
          A backend engineer building scalable data pipelines, agentic AI systems,
          and developer tools. Shipping production-grade software, not prototypes.
        </p>
      </div>

      <!-- Sitemap links -->
      <div class="footer-col">
        <h5>Navigation</h5>
        <ul>
          <li><a href="#home">Home</a></li>
          <li><a href="#about">About</a></li>
          <li><a href="#experience">Experience</a></li>
          <li><a href="#projects">Projects</a></li>
        </ul>
      </div>

      <!-- Connect links -->
      <div class="footer-col">
        <h5>Connect</h5>
        <ul>
          <li>
            <a
              href="https://github.com/sangeeth98"
              target="_blank"
              rel="noopener noreferrer">GitHub</a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/in/sangeethkumarvm/"
              target="_blank"
              rel="noopener noreferrer">LinkedIn</a>
          </li>
          <li>
            <a
              href="https://x.com/sangeethkumarvm"
              target="_blank"
              rel="noopener noreferrer">X / Twitter</a>
          </li>
          <li>
            <a
              href="https://github.com/sangeeth98/portfolio"
              target="_blank"
              rel="noopener noreferrer">Source Code</a>
          </li>
        </ul>
      </div>
    </footer>

    <!-- Bottom Bar -->
    <div class="footer-bottom-bar">
      <p>
        © 2026 <strong>Sangeeth</strong>. Built with Astro & vanilla CSS.
      </p>
      <p>
        <span class="footer-status">
          <span class="status-dot"></span>
          All systems operational
        </span>
      </p>
    </div>
  </div>
</section>

<style>
  .contact-section {
    position: relative;
    padding-bottom: var(--space-8);
    background: transparent;
  }

  .footer-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-primary), transparent);
    margin: var(--space-4) 0 var(--space-6) 0;
  }

  .logo-bracket {
    color: var(--neon-cyan);
    font-weight: 400;
    opacity: 0.6;
  }

  .footer-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--neon-green);
    box-shadow: 0 0 8px rgba(0, 255, 65, 0.5);
    animation: glowPulse 2s ease-in-out infinite;
  }

  @keyframes glowPulse {
    0%, 100% { box-shadow: 0 0 4px rgba(0, 255, 65, 0.3); }
    50% { box-shadow: 0 0 12px rgba(0, 255, 65, 0.6); }
  }
</style>
