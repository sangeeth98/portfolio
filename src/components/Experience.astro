---
// Experience.astro: Vague timeline (no company names, no cities) + skill matrix
---

<section id="experience" class="experience-section">
  <div class="container">
    <h2 class="section-title">experience.log</h2>
    
    <div class="experience-layout">
      <!-- Timeline column -->
      <div class="timeline">
        
        <!-- Current Role -->
        <div class="timeline-item">
          <div class="timeline-dot active"></div>
          <div class="terminal-card timeline-card">
            <span class="role-duration"><span class="duration-icon">●</span> Current Role</span>
            <h3 class="role-title">Backend Engineer — Data & Analytics Platform</h3>
            <p class="role-description">
              Building and maintaining enterprise-scale data pipelines for a global analytics 
              company. Engineering Python-based automation services, optimizing database 
              performance, and working within cross-functional distributed teams under Agile.
            </p>
            <ul class="role-bullet-list">
              <li>Architected modular Python services for large-scale consumer measurement data processing</li>
              <li>Optimized SQL pipelines and database structures for high-throughput analytics workloads</li>
              <li>Built internal monitoring dashboards and automation tooling to reduce manual overhead</li>
            </ul>
          </div>
        </div>

        <!-- Previous Role -->
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="terminal-card timeline-card">
            <span class="role-duration">Previous Role — ~2.5 years</span>
            <h3 class="role-title">Systems Engineer — Backend & Data Engineering</h3>
            <p class="role-description">
              Backend development and data engineering at a large IT services company.
              Focused on legacy system modernization, cloud migration prep, and building 
              modular Python architectures.
            </p>
            <ul class="role-bullet-list">
              <li>Refactored enterprise legacy systems into modular Python architectures for cloud readiness</li>
              <li>Managed backend integrations with Apache Hive, Oracle DB, and enterprise data frameworks</li>
              <li>Recognized for code quality and championing modern engineering practices</li>
            </ul>
          </div>
        </div>

        <!-- Education (minimal) -->
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="terminal-card timeline-card education-card">
            <span class="role-duration">Education</span>
            <h3 class="role-title">B.Tech — Electronics & Communication (IoT Specialization)</h3>
            <p class="role-description">
              Graduated with distinction. Built capstone projects in computer vision (OpenCV, 
              YOLO), IoT sensor networks, and ML-based prediction systems.
            </p>
          </div>
        </div>

      </div>

      <!-- Skills column -->
      <div class="skills-panel">
        <div class="terminal-card terminal-card-windowed skills-card">
          <h3 class="card-heading"><span class="heading-accent">#</span> tech_stack</h3>
          <p class="skills-intro">Tools and technologies I work with daily.</p>
          
          <div class="skill-category">
            <h4>Languages</h4>
            <div class="skill-tags">
              <span>Python</span>
              <span>TypeScript</span>
              <span>JavaScript</span>
              <span>SQL</span>
              <span>Rust</span>
            </div>
          </div>

          <div class="skill-category">
            <h4>Backend & Data</h4>
            <div class="skill-tags">
              <span>FastAPI</span>
              <span>Node.js</span>
              <span>PostgreSQL</span>
              <span>Redis</span>
              <span>Apache Hive</span>
              <span>Oracle DB</span>
            </div>
          </div>

          <div class="skill-category">
            <h4>AI & Agentic Systems</h4>
            <div class="skill-tags">
              <span>LangChain</span>
              <span>LlamaIndex</span>
              <span>Gemini API</span>
              <span>RAG Pipelines</span>
              <span>Tool Calling</span>
              <span>Prompt Engineering</span>
            </div>
          </div>

          <div class="skill-category">
            <h4>Infrastructure & Tools</h4>
            <div class="skill-tags">
              <span>Docker</span>
              <span>Git / GitHub</span>
              <span>CI/CD</span>
              <span>uv</span>
              <span>Astro</span>
              <span>Linux</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .experience-section {
    background: transparent;
  }

  .experience-layout {
    display: grid;
    grid-template-columns: 1.3fr 0.9fr;
    gap: var(--space-7);
  }

  /* Timeline styling */
  .timeline {
    position: relative;
    border-left: 1px solid var(--border-primary);
    padding-left: var(--space-5);
    margin-left: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 0;
    left: -1px;
    width: 1px;
    height: 60px;
    background: linear-gradient(to bottom, transparent, var(--neon-green));
  }

  .timeline-item {
    position: relative;
  }

  .timeline-dot {
    position: absolute;
    left: calc(-1 * var(--space-5) - 6px);
    top: 24px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg-tertiary);
    border: 2px solid var(--neon-green-dim);
  }

  .timeline-dot.active {
    background: var(--neon-green);
    border-color: var(--neon-green);
    box-shadow: 0 0 12px rgba(0, 255, 65, 0.5);
    animation: glowPulse 2s ease-in-out infinite;
  }

  .timeline-card {
    padding: var(--space-5);
  }

  .role-duration {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.78rem;
    color: var(--neon-green);
    margin-bottom: var(--space-2);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .duration-icon {
    font-size: 0.5rem;
    animation: blink 1.5s ease-in-out infinite;
  }

  .role-title {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    color: var(--text-primary);
    margin-bottom: 0.4rem;
    font-weight: 600;
  }

  .role-description {
    font-family: var(--font-body);
    font-size: 0.92rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
    line-height: 1.7;
  }

  .role-bullet-list {
    list-style: none;
    padding-left: 0.5rem;
  }

  .role-bullet-list li {
    position: relative;
    padding-left: 1.2rem;
    font-family: var(--font-body);
    font-size: 0.88rem;
    color: var(--text-secondary);
    margin-bottom: 0.4rem;
    line-height: 1.6;
  }

  .role-bullet-list li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--neon-green);
    font-family: var(--font-mono);
  }

  /* Skills Panel */
  .card-heading {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    margin-bottom: var(--space-3);
    color: var(--text-primary);
    display: inline-block;
  }

  .heading-accent {
    color: var(--neon-green);
    margin-right: 0.3rem;
  }

  .skills-intro {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .skill-category {
    margin-bottom: var(--space-4);
  }

  .skill-category:last-child {
    margin-bottom: 0;
  }

  .skill-category h4 {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-dimmed);
    margin-bottom: var(--space-2);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .education-card .role-title {
    font-size: 1rem;
  }

  @media (max-width: 900px) {
    .experience-layout {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .skills-panel {
      order: -1;
    }
  }
</style>
