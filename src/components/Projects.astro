---
// Projects.astro: Featured projects — cogniverse, resume_builder, portfolio
---

<section id="projects" class="projects-section">
  <div class="container">
    <h2 class="section-title">./projects</h2>
    
    <!-- Category Filter Bar -->
    <div class="project-filters" role="tablist" aria-label="Filter projects">
      <button type="button" class="filter-btn active" data-filter="all">
        <span>All</span>
        <span class="filter-count">03</span>
      </button>
      <button type="button" class="filter-btn" data-filter="ai">
        <span>AI & Agents</span>
        <span class="filter-count">02</span>
      </button>
      <button type="button" class="filter-btn" data-filter="web">
        <span>Web & Systems</span>
        <span class="filter-count">01</span>
      </button>
    </div>

    <div class="projects-grid" id="projects-grid">
      
      <!-- Project 1: Cogniverse (Flagship Personal Project) -->
      <div class="terminal-card project-card featured" data-category="ai">
        <div class="project-header">
          <div class="header-left">
            <span class="project-icon">🧠</span>
            <span class="card-index">#01</span>
          </div>
          <span class="project-category">Featured · AI Knowledge Engine</span>
        </div>
        <h3 class="project-title">cogniverse</h3>
        <p class="project-description">
          Flagship personal project: A next-generation personal knowledge engine and interactive 3D 
          constellation visualizer built on Google's Open Knowledge Format (OKF v0.2). Features a 
          Python AST compiler, 3D force-directed graph visualization, and agent-optimized document structures.
        </p>
        <div class="project-tech">
          <span>Python</span>
          <span>OKF v0.2</span>
          <span>3D Force Graph</span>
          <span>FastAPI</span>
          <span>D3.js</span>
        </div>
        <a href="https://github.com/sangeeth98" target="_blank" rel="noopener noreferrer" class="project-link">
          view source <span>→</span>
        </a>
      </div>

      <!-- Project 2: Resume Builder & OKF Agent -->
      <div class="terminal-card project-card" data-category="ai">
        <div class="project-header">
          <div class="header-left">
            <span class="project-icon">⚡</span>
            <span class="card-index">#02</span>
          </div>
          <span class="project-category">Agentic Systems / Compilers</span>
        </div>
        <h3 class="project-title">resume_builder</h3>
        <p class="project-description">
          Agentic CLI & knowledge compiler that parses Google Open Knowledge Format (OKF v0.2) 
          corpora to synthesize tailored, 100% ATS-compliant multi-format resumes (PDF, HTML, TXT, 
          Markdown) with automated skill-gap analysis and keyword scoring.
        </p>
        <div class="project-tech">
          <span>Python</span>
          <span>Typer</span>
          <span>OKF v0.2</span>
          <span>Headless Chrome</span>
          <span>uv</span>
        </div>
      </div>

      <!-- Project 3: This Portfolio -->
      <div class="terminal-card project-card" data-category="web">
        <div class="project-header">
          <div class="header-left">
            <span class="project-icon">💻</span>
            <span class="card-index">#03</span>
          </div>
          <span class="project-category">Web / Frontend</span>
        </div>
        <h3 class="project-title">portfolio</h3>
        <p class="project-description">
          Minimalist cyberpunk portfolio site. Built with Astro, vanilla CSS, and zero client 
          JavaScript framework overhead. Features matrix rain canvas animation, terminal-style UI, 
          CRT scanlines, and a monospace-forward design system.
        </p>
        <div class="project-tech">
          <span>Astro</span>
          <span>CSS</span>
          <span>TypeScript</span>
        </div>
        <a href="https://github.com/sangeeth98/portfolio" target="_blank" rel="noopener noreferrer" class="project-link">
          view source <span>→</span>
        </a>
      </div>

    </div>
  </div>
</section>

<script>
  // Project filter functionality
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const projectCards = document.querySelectorAll<HTMLElement>('.project-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.dataset.filter || 'all';

      projectCards.forEach((card) => {
        const categories = (card.dataset.category || '').split(' ');
        const matches = filter === 'all' || categories.includes(filter);

        if (matches) {
          card.style.display = 'flex';
          card.style.animation = 'fadeInUp 0.3s ease forwards';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  .projects-section {
    background: transparent;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
    gap: var(--space-5);
  }

  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-5);
    position: relative;
  }

  .project-card.featured {
    border-color: rgba(0, 255, 65, 0.25);
  }

  .project-card.featured::before {
    background: linear-gradient(90deg, transparent, rgba(0, 255, 65, 0.3), transparent);
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .project-icon {
    font-size: 1.4rem;
    line-height: 1;
  }

  .project-actions {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    flex-wrap: wrap;
  }

  .project-category {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--neon-green);
    letter-spacing: 0.06em;
    opacity: 0.8;
  }

  .project-title {
    font-family: var(--font-mono);
    font-size: 1.2rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
    font-weight: 600;
  }

  .project-title::before {
    content: '> ';
    color: var(--neon-green);
    opacity: 0.5;
  }

  .project-description {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: var(--space-4);
    flex-grow: 1;
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: var(--space-4);
  }

  .project-tech span {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    background: rgba(0, 255, 65, 0.06);
    color: var(--text-dimmed);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-primary);
    letter-spacing: 0.02em;
  }

  .project-link {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--neon-green) !important;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    transition: gap 0.2s, text-shadow 0.2s;
    letter-spacing: 0.02em;
  }

  .project-link:hover {
    gap: 0.6rem;
    text-shadow: 0 0 8px rgba(0, 255, 65, 0.4);
  }

  .project-link span {
    font-size: 1rem;
    line-height: 1;
    transition: transform 0.2s;
  }

  .project-link:hover span {
    transform: translateX(3px);
  }
</style>
